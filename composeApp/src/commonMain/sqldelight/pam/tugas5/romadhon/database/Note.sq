CREATE TABLE NoteEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    date TEXT NOT NULL,
    color INTEGER NOT NULL,
    is_favorite INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM NoteEntity ORDER BY id DESC;

selectFavorites:
SELECT * FROM NoteEntity WHERE is_favorite = 1 ORDER BY id DESC;

selectById:
SELECT * FROM NoteEntity WHERE id = ?;

searchNotes:
SELECT * FROM NoteEntity WHERE title LIKE '%' || :query || '%' OR content LIKE '%' || :query || '%';

insertNote:
INSERT INTO NoteEntity(title, content, date, color, is_favorite)
VALUES (?, ?, ?, ?, ?);

updateNote:
UPDATE NoteEntity SET title = ?, content = ? WHERE id = ?;

toggleFavorite:
UPDATE NoteEntity SET is_favorite = ? WHERE id = ?;

deleteNote:
DELETE FROM NoteEntity WHERE id = ?;